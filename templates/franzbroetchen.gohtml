<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" href="/assets/images/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="/assets/images/favicon.ico" sizes="32x32">
  <link rel="apple-touch-icon" href="/assets/images/apple-touch-icon.png">
  <meta name="description" content="Franzbrötchen reviews">
  <title>Franzbrötchen — Alex Raskin</title>
  {{ with .CDNBase }}<link rel="preconnect" href="{{ . }}">{{ end }}
  <link rel="preload" href="/assets/fonts/B612-Regular.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/assets/fonts/B612-Bold.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/assets/css/style.css?v=4">
</head>
<body>
  <div class="container">
    <main>
      <h2>Franzbrötchen
        <img class="emoji" src="/assets/images/franzbroetchen/franzbroetchen.png"
             width="128" height="128" alt="" aria-hidden="true"></h2>

      <p>Franzbrötchen is my favorite pastry. Here are the ones I have tried,
        rated out of five.</p>

      {{ $thumb := "(max-width: 30rem) 7rem, 9rem" }}
      {{ range $i, $review := .Reviews }}
        <article class="review">
          <h3 class="review-place">
            {{ with $review.URL }}<a href="{{ . }}">{{ $review.Place }}</a>{{ else }}{{ $review.Place }}{{ end }}
          </h3>
          <p class="review-meta">
            <span class="rating" role="img" aria-label="{{ $review.Rating }} out of 5">{{ $review.Stars }}</span>
            <span class="muted">{{ $review.Location }} · {{ $review.Day }}</span>
          </p>
          <div class="review-photos">
            {{ range $j, $photo := $review.Photos }}
              <a href="{{ $photo.Src }}"><img class="review-photo"
                   src="{{ $photo.Src }}"
                   srcset="{{ $photo.Srcset }}"
                   sizes="{{ $thumb }}"
                   width="{{ $photo.DisplayWidth }}"
                   height="{{ $photo.DisplayHeight }}"
                   {{ if $j }}alt="Another photo from {{ $review.Place }}"{{ else }}alt="Franzbrötchen from {{ $review.Place }}"{{ end }}
                   {{ if or $i $j }}loading="lazy" {{ else }}fetchpriority="high" {{ end }}decoding="async"></a>
            {{ end }}
          </div>
          {{ with $review.Note }}<p class="review-note">{{ . }}</p>{{ end }}
        </article>
      {{ else }}
        <p class="muted">No Franzbrötchen yet. Unlikely, but possible.</p>
      {{ end }}

      <p><a href="/">← Back home</a></p>
    </main>
  </div>
</body>
</html>
