<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" href="{{ asset "/assets/images/favicon.svg" }}" type="image/svg+xml">
  <link rel="icon" href="{{ asset "/assets/images/favicon.ico" }}" sizes="32x32">
  <link rel="apple-touch-icon" href="{{ asset "/assets/images/apple-touch-icon.png" }}">
  <meta name="description" content="Franzbrötchen reviews by Alex Raskin — rated out of five, one bakery at a time.">
  <title>Franzbrötchen — Alex Raskin</title>
  <link rel="preload" href="{{ asset "/assets/fonts/B612-Regular.woff2" }}" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="{{ asset "/assets/fonts/B612-Bold.woff2" }}" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="{{ asset "/assets/css/style.css" }}">
</head>
<body>
  <div class="container">
    <main>
      <h2>Franzbrötchen
        <img class="emoji" src="{{ asset "/assets/images/franzbroetchen/franzbroetchen.png" }}"
             width="128" height="128" alt="" aria-hidden="true"></h2>

      <p>Franzbrötchen is my favorite pastry. Here are the ones I have tried,
        rated out of five.</p>

      {{ $sizes := "(max-width: 42rem) calc(100vw - 2.5rem), 608px" }}
      {{ range $i, $review := .Reviews }}
        <article class="review">
          <h3 class="review-place">
            {{ with $review.URL }}<a href="{{ . }}">{{ $review.Place }}</a>{{ else }}{{ $review.Place }}{{ end }}
          </h3>
          <p class="review-meta">
            <span class="rating" role="img" aria-label="{{ $review.Rating }} out of 5">{{ $review.Stars }}</span>
            <span class="muted">{{ $review.Location }} · {{ $review.Day }}</span>
          </p>
          <picture>
            {{ with $review.AVIF }}<source type="image/avif" srcset="{{ srcset . }}" sizes="{{ $sizes }}">{{ end }}
            <img class="review-photo"
                 src="{{ asset $review.Fallback.URL }}"
                 srcset="{{ srcset $review.JPEG }}"
                 sizes="{{ $sizes }}"
                 width="{{ $review.Width }}"
                 height="{{ $review.Height }}"
                 alt="Franzbrötchen from {{ $review.Place }}"
                 {{ if $i }}loading="lazy" {{ end }}decoding="async">
          </picture>
          {{ with $review.Note }}<p class="review-note">{{ . }}</p>{{ end }}
        </article>
      {{ else }}
        <p class="muted">No Franzbrötchen yet. Unlikely, but possible.</p>
      {{ end }}

      <p><a href="/">← Back home</a></p>
    </main>
  </div>
</body>
</html>
