# HTML keeps default (max-age=0 + ETag) so deploys show up immediately.

# Never change in place: rename file if they ever do.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/js/*
  Cache-Control: public, max-age=31536000, immutable

# Can change between deploys, no fingerprinting: short TTL, revalidate in background.
/css/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/img/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/icons/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/favicon.ico
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
